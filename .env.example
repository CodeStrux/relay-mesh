# relay-mesh configuration — copy to .env and fill in.
# Every value here is the default; model IDs live ONLY in env (never in code).

# --- Required ---
# Seed locally from 1Password: op read -n 'op://<vault>/<item>/api-key'
OPENROUTER_API_KEY=

# --- OpenRouter ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RELAY_HTTP_REFERER=https://github.com/CodeStrux/relay-mesh
RELAY_X_TITLE=relay-mesh

# --- Relay root (the filesystem IS the state) ---
RELAY_ROOT=./relay
# RELAY_PROFILES=./profiles.json

# --- Model per profile (defaults are examples; `relay-mesh doctor` validates slugs) ---
PLANNER_MODEL=z-ai/glm-5.2
RECON_CODE_MODEL=deepseek/deepseek-v4-pro
VISION_MODEL=google/gemma-4-26b-a4b-it
BACKEND_MODEL=z-ai/glm-5.2
FRONTEND_MODEL=moonshotai/kimi-k2.7-code
INFRA_MODEL=z-ai/glm-5.2
MONITOR_MODEL=google/gemma-4-31b-it

# --- Tuning ---
MONITOR_POLL_MS=15000
MAX_FIX_ROUNDS=3
# RELAY_DEBUG=1
